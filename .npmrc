# This repository had no dependency before @sasjs/release, so these are the
# defaults a fresh clone would otherwise not have.
#
# A dependency's install scripts do not run: nothing here needs one, and the tool
# is read from the lockfile rather than built. The hook setup that used to run as
# postinstall is an explicit `npm run hooks` instead - see README.txt.
ignore-scripts=true
# A dependency is pinned exactly, so a bump is a diff in package.json as well as in
# the lockfile rather than a re-resolved range.
save-exact=true
